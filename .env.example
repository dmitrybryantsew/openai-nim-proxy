PORT=3000
PROXY_API_KEY=replace-with-a-long-random-secret
CORS_ORIGIN=*

NIM_API_BASE=https://integrate.api.nvidia.com/v1
NIM_API_KEY=nvapi-your-nvidia-key
NIM_FEATURED_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_INCLUDE_PAID=false
OPENROUTER_INCLUDE_MULTIMODAL_OUTPUT=true
OPENROUTER_APP_TITLE=openai-nim-proxy
# OPENROUTER_APP_URL=https://your-domain.example

DEFAULT_MAX_TOKENS=4096
REQUEST_TIMEOUT_MS=120000
MODEL_TEST_TIMEOUT_MS=30000
MODEL_CACHE_TTL_MS=300000
MODEL_CACHE_FILE=data/models-cache.json

SHOW_REASONING=false
ENABLE_THINKING_MODE=false
THINKING_MODELS=nim:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
DEFAULT_REASONING_BUDGET=16384
